# ──────────────────────────────────────────────
#  Antigravity News Bot — Environment Variables
# ──────────────────────────────────────────────

# ── Telegram User API (for reading channels via Telethon)
# Get from https://my.telegram.org → "API development tools"
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# ── Telegram Bot Token (from @BotFather)
TG_BOT_TOKEN=your_bot_token_here

# ── OpenRouter API Key (free tier)
# Get from https://openrouter.ai → Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Best free model for this task (reasoning + long context):
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Admin Telegram User IDs (comma-separated)
# Find your ID via @userinfobot on Telegram
ADMIN_USER_IDS=123456789,987654321

# ── App Settings
LOOKBACK_HOURS=24
DIGEST_HOUR=6
FETCH_INTERVAL_MINUTES=30
MESSAGES_PER_CHANNEL=30
